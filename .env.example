# Database (Hostinger MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://username:password@your-hostinger-host:3306/your_database"

# NextAuth.js
# Generate with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET="your-random-secret-here"

# App URL
NEXTAUTH_URL="https://your-domain.com"

# Google OAuth
# 설정: https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# 승인된 리디렉션 URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Kakao OAuth
# 설정: https://developers.kakao.com → 내 애플리케이션
# 플랫폼 → Web → 사이트 도메인 등록
# 카카오 로그인 → 활성화 ON
# 리디렉션 URI: https://your-domain.com/api/auth/callback/kakao
KAKAO_CLIENT_ID="your-kakao-rest-api-key"
KAKAO_CLIENT_SECRET="your-kakao-client-secret"  # 카카오 로그인 → 보안 → Client Secret

# SMTP Email (Gmail 또는 다른 SMTP 서비스)
# Gmail 사용 시: https://myaccount.google.com/apppasswords에서 앱 비밀번호 생성
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@yourdomain.com"
